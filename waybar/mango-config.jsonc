{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,

  // 1. CHOOSE YOUR MODULE LAYOUT
  "modules-left": [
    "mango/workspaces",
    "mango/layout",
    "mango/window"
  ],
  "modules-center": [
    "custom/weather",
    "clock",
    "custom/luna"
  ],
  "modules-right": [
    "mpd",
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "temperature",
    "backlight",
    "battery",
    "tray"
  ],

  // =========================================================================
  // NATIVE MANGO MODULE CONFIGURATION
  // =========================================================================
  "mango/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "on-click-right": "toggle",
    "all-outputs": true,
    "hide-empty": false, 
    "persistent-workspaces": {
        "1": [],
        "2": [],
        "3": [],
        "4": [],
        "5": [],
        "6": [],
        "7": [],
        "8": [],
        "9": []
    }
  },

  "mango/keymode": {
      "format": "{}"
  },
  "mango/window": {
      "format": "{}",
      "icon-size": 20
  },
  "mango/layout": {
      "format": "{}"
  },
  "mango/language": {
      "format": "{short}"
  },

  // =========================================================================
  // CUSTOM MODULE DEFINITIONS
  // =========================================================================
  "tray": {
      "icon-size": 18,
      "spacing": 10
  },

  "clock": {
      "timezone": "America/New_York",
      "interval": 1,
      "format": "{:%a, %b %d %H:%M:%S}",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "format-alt": "{:%Y-%m-%d}"
  },

  "custom/weather": {
        "exec": "~/.config/waybar/scripts/weather.sh",
        "tooltip": false,
        "interval": 600,
        "format": "{}"
    },

 "custom/luna": {
        "exec": "~/.config/waybar/scripts/luna.sh",
        "tooltip": false,
        "interval": 600,
        "format": "{}"
    },

  "pulseaudio": {
      "format": "{volume}% {icon} {format_source}",
      "format-bluetooth": "{volume}% {icon} {format_source}",
      "format-bluetooth-muted": " {icon} {format_source}",
      "format-muted": " {format_source}",
      "format-source": "{volume}% ",
      "format-source-muted": "",
      "format-icons": {
          "headphone": "",
          "hands-free": "",
          "headset": "",
          "phone": "",
          "portable": "",
          "car": "",
          "default": ["", "", ""]
      },
      "on-click": "pavucontrol"
  },


  "network": {
      "format-wifi": "   {essid}",
      "format-ethernet": "     {bandwidthDownBits}",
      "interval": 5,
      "tooltip-format": "{ifname} via {gwaddr} ",
      "format-linked": "{ifname} (No IP) ",
      "format-disconnected": "Disconnected ⚠",
      "format-alt": "{ifname}: {ipaddr}/{cidr}"
  },


  "cpu": {
      "format": " {usage}%",
      "tooltip": false
  },

  "memory": {
      "format": " {}%"
  },

  "temperature": {
      "critical-threshold": 80,
      "format": "{temperatureC}°C {icon}",
      "format-icons": ["", "", ""]  // [Cold, Normal, Hot]
  },


  "backlight": {
      "format": "{percent}% {icon}",
      "format-icons": ["", "", "", "", "", "", "", "", ""]
  },

  "battery": {
      "states": {
          "warning": 30,
          "critical": 15
      },
      "format": "{capacity}% {icon}",
      "format-full": "{capacity}% {icon}",
      "format-charging": "{capacity}% ",
      "format-plugged": "{capacity}% ",
      "format-alt": "{time} {icon}",
      "format-icons": ["", "", "", "", ""]
  },

  "mpd": {
      "format": " {title} - {artist}",
      "format-disconnected": "Disconnected ",
      "format-stopped": "Stopped ",
      "interval": 2,
      "consume-icons": {
          "on": " "
      },
      "random-icons": {
          "on": " "
      },
      "repeat-icons": {
          "on": " "
      },
      "single-icons": {
          "on": "1 "
      },
      "state-icons": {
          "paused": "",
          "playing": ""
      },
      "tooltip-format": "MPD (connected)",
      "tooltip-format-disconnected": "MPD (disconnected)"
  }
}

