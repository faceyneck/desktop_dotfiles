{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,

  // 1. CHOOSE YOUR MODULE LAYOUT
  "modules-left": [
    "mango/workspaces",
    "mango/layout",
    "mango/window"
  ],
  "modules-center": [
    "clock" // <--- Paste your custom center modules here!
  ],
  "modules-right": [
    // "mango/language",
    // "mango/keymode",
    // "pulse-audio", // <--- Paste your custom right modules here!
    "mpd",
    // "idle_inhibitor",
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "temperature",
    "backlight",
        //"keyboard-state",
        // "sway/language",
    "battery",
        // "battery#bat2",
    "tray"

  ],

  // =========================================================================
  // NATIVE MANGO MODULE CONFIGURATION
  // =========================================================================
  "mango/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "on-click-right": "toggle",
    "all-outputs": true,
    // 1. Force empty tags to stay visible
    "hide-empty": false, 
    // 2. Define the persistent layout boundaries
    "persistent-workspaces": {
        "1": [],
        "2": [],
        "3": [],
        "4": [],
        "5": [],
        "6": [],
        "7": [],
        "8": [],
        "9": []
    }
},

  "mango/keymode": {
      "format": "{}"
  },
  "mango/window": {
      "format": "{}",
      "icon-size": 20
  },
  "mango/layout": {
      "format": "{}"
  },
  "mango/language": {
      "format": "{short}"
  },

  // =========================================================================
  // PASTE YOUR OWN CUSTOM MODULE DEFINITIONS BELOW THIS LINE
  // =========================================================================
  "tray": {
      "icon-size": 18,
      "spacing": 10
  }

},
  "clock": {
      "timezone": "America/New_York",
	    "interval": 1,
	    "format": "{:%a, %b %d %H:%M:%S}",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "format-alt": "{:%Y-%m-%d}"
    },

"pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },


"network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "  {bandwidthDownBits}",
        "format-ethernet": "󰈀 {bandwidthDownBits}",
	"interval": 5,
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },

"clock": {
        "timezone": "America/New_York",
	"interval": 1,
	"format": "{:%a, %b %d %H:%M:%S}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": " {usage}%",
        "tooltip": false
    },
    "memory": {
        "format": " {}%"
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "battery#bat2": {
        "bat": "BAT2"
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "  {bandwidthDownBits}",
        "format-ethernet": "󰈀 {bandwidthDownBits}",
	"interval": 5,
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
